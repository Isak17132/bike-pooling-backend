{
  "name": "expo-modules-cli",
  "version": "0.3.1",
  "description": "Command-line tools for developing Expo modules.",
  "keywords": [
    "cli",
    "expo",
    "expo-module"
  ],
  "homepage": "https://github.com/expo/expo/tree/main/packages/expo-modules-cli#readme",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-modules-cli"
  },
  "bin": {
    "expo-modules": "bin/expo-modules.js"
  },
  "files": [
    "bin",
    "build"
  ],
  "main": "build/index.js",
  "dependencies": {
    "arg": "^5.0.2"
  },
  "devDependencies": {
    "@expo/internal-scripts": "58.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "expo-modules-macros": "0.21.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "build": "expo-build cjs:src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "expo-module": "expo-module",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json"
